<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Smart Warehouse</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-shell">
            <aside class="app-nav">
                <div class="brand">
                    <span class="brand-light"></span>
                    <div>
                        <strong>Smart Warehouse</strong>
                        <small>Admin console</small>
                    </div>
                </div>
                <nav>
                    <a asp-controller="Inventory" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" ? "active" : null)">Inventory</a>
                    <a asp-controller="Orders" asp-action="Create" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : null)">Create order</a>
                    <a asp-controller="Orders" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" && ViewContext.RouteData.Values["action"]?.ToString() != "Create" ? "active" : null)">Orders</a>
                    <a asp-controller="Inbound" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Inbound" ? "active" : null)">Inbound queue</a>
                    <a asp-controller="Workers" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Workers" ? "active" : null)">Workers</a>
                </nav>
                <div class="nav-foot">
                    <div>@User.Identity?.Name</div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit">Sign out</button>
                    </form>
                </div>
            </aside>
            <main class="app-main">
                @if (TempData["Success"] is string success)
                {
                    <div class="flash ok">@success</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="flash bad">@error</div>
                }
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="login-shell">
            @RenderBody()
        </main>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
